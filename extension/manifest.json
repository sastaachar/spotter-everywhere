{
  "manifest_version": 3,
  "name": "Spotter Everywhere",
  "version": "0.1.0",
  "description": "Adds a ThoughtSpot Spotter button to Tableau and Power BI, picking the right code for the site it loads on.",
  "key": "",
  "host_permissions": [
    "https://172.32.111.47:8443/*",
    "https://prod-in-a.online.tableau.com/*",
    "https://app.powerbi.com/*",
    "https://spotter-everywhere.thoughtspotdev.cloud/*",
    "https://jm-saas-2.internal.thoughtspot.dev/*",
    "http://localhost:8799/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "dist/*"
      ],
      "matches": [
        "https://prod-in-a.online.tableau.com/*",
        "https://app.powerbi.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://prod-in-a.online.tableau.com/*"
      ],
      "js": [
        "platforms/tableau/content.js"
      ],
      "css": [
        "platforms/tableau/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://prod-in-a.online.tableau.com/*"
      ],
      "js": [
        "platforms/tableau/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "platforms/powerbi/content.js"
      ],
      "css": [
        "platforms/powerbi/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "platforms/powerbi/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
