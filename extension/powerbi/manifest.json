{
  "manifest_version": 3,
  "name": "Power BI Spotter",
  "version": "0.1.0",
  "description": "Adds a Spotter button to Power BI report visual titles.",
  "host_permissions": [
    "https://app.powerbi.com/*",
    "http://localhost:8787/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "https://app.powerbi.com/*"
      ]
    }
  ]
}
