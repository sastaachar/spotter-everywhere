{
  "manifest_version": 3,
  "name": "Tableau Spotter",
  "version": "0.1.0",
  "description": "Adds a Spotter button to Tableau Cloud sheet titles.",
  "permissions": ["storage"],
  "host_permissions": ["https://prod-in-a.online.tableau.com/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://prod-in-a.online.tableau.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://prod-in-a.online.tableau.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
